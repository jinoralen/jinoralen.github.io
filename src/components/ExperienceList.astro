---
// Work history, newest first, then education.
// Dates on the left, a rule, details on the right.
import { education, experience } from '../data/site';
---

<div class="space-y-8">
	{experience.map((c) => (
		<div id={c.id} class="scroll-mt-4">
			<h2 class="mb-2 text-lg text-heading sm:ms-[6.5rem]">
				<strong class="[font-variant:small-caps]">{c.name}</strong>
			</h2>
			<div class="space-y-7">
				{c.roles.map((r) => (
					<article id={r.id} class="scroll-mt-4 sm:grid sm:grid-cols-[5.5rem_1fr]">
						{/* The rule spans the whole role; the dates stick to the top while it scrolls. */}
						<div class="sm:border-e sm:border-rule sm:pe-3">
							<p class="text-sm text-muted sm:sticky sm:top-4 sm:text-center sm:text-base sm:text-fg">
								<strong class="sm:block">{r.start}</strong>
								<span class="sm:hidden"> – </span>
								<strong class="sm:block">{r.end}</strong>
							</p>
						</div>
						<div class="sm:ps-4">
							<h3 class="text-heading">
								<strong>{r.title}</strong>
							</h3>
							<div class="mt-1 space-y-2 text-justify hyphens-auto">
								{r.summary.map((p) => (
									<p set:html={p} />
								))}
							</div>
							{r.groups.map((g) => (
								<div class="mt-3">
									{g.title && (
										<p>
											<strong>{g.title}:</strong>
										</p>
									)}
									<ul class="chevron-list mt-1">
										{g.items.map((i) => (
											<li set:html={i} />
										))}
									</ul>
								</div>
							))}
							<ul class="mt-3 flex flex-wrap gap-1" aria-label="Technologies">
								{r.tags.map((t) => (
									<li class="tag">{t}</li>
								))}
							</ul>
						</div>
					</article>
				))}
			</div>
		</div>
	))}
	{/* Education closes the timeline, in the same layout as a role. */}
	<div id={education.id} class="scroll-mt-4">
		<h2 class="mb-2 text-lg text-heading sm:ms-[6.5rem]">
			<strong class="[font-variant:small-caps]">{education.school}</strong>
		</h2>
		<article class="sm:grid sm:grid-cols-[5.5rem_1fr]">
			<div class="sm:border-e sm:border-rule sm:pe-3">
				<p class="text-sm text-muted sm:text-center sm:text-base sm:text-fg">
					<strong class="sm:block">{education.start}</strong>
					<span class="sm:hidden"> – </span>
					<strong class="sm:block">{education.end}</strong>
				</p>
			</div>
			<div class="sm:ps-4">
				<h3 class="text-heading">
					<strong>{education.degree}</strong>
				</h3>
				<p class="mt-1">{education.location}</p>
			</div>
		</article>
	</div>
</div>
